---
import type { CategoryMeta, LearningRepo } from '../types/repo';
import RepoCard from './RepoCard.astro';

interface Props {
  category: CategoryMeta;
  repos: LearningRepo[];
}

const { category, repos } = Astro.props;
---

<section
  id={`cat-${category.id}`}
  class="category-section mb-16 scroll-mt-24 transition-opacity duration-300"
  data-category-section={category.id}
>
  <!-- Category Section Header -->
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-6 pb-4 border-b border-white/[0.08]">
    <div class="flex items-start gap-3.5">
      <div class={`w-11 h-11 rounded-xl bg-gradient-to-tr ${category.gradient} p-[1px] shadow-lg flex-shrink-0`}>
        <div class="w-full h-full bg-[#0b0f1a] rounded-[11px] flex items-center justify-center">
          <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            {category.icon === 'layout' && (
              <>
                <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
                <line x1="3" x2="21" y1="9" y2="9"/>
                <line x1="9" x2="9" y1="21" y2="9"/>
              </>
            )}
            {category.icon === 'server' && (
              <>
                <rect width="20" height="8" x="2" y="2" rx="2" ry="2"/>
                <rect width="20" height="8" x="2" y="14" rx="2" ry="2"/>
                <line x1="6" x2="6.01" y1="6" y2="6"/>
                <line x1="6" x2="6.01" y1="18" y2="18"/>
              </>
            )}
            {category.icon === 'cloud' && (
              <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/>
            )}
            {category.icon === 'database' && (
              <>
                <ellipse cx="12" cy="5" rx="9" ry="3"/>
                <path d="M3 5V19A9 3 0 0 0 21 19V5"/>
                <path d="M3 12A9 3 0 0 0 21 12"/>
              </>
            )}
            {category.icon === 'code' && (
              <>
                <polyline points="16 18 22 12 16 6"/>
                <polyline points="8 6 2 12 8 18"/>
              </>
            )}
            {category.icon === 'cpu' && (
              <>
                <rect width="16" height="16" x="4" y="4" rx="2"/>
                <rect width="6" height="6" x="9" y="9"/>
                <path d="M15 2v2"/><path d="M15 20v2"/><path d="M2 15h2"/><path d="M2 9h2"/><path d="M20 15h2"/><path d="M20 9h2"/><path d="M9 2v2"/><path d="M9 20v2"/>
              </>
            )}
          </svg>
        </div>
      </div>

      <div>
        <div class="flex items-center gap-3">
          <h2 class="text-2xl font-bold text-white tracking-tight">
            {category.name}
          </h2>
          <span class="category-count text-xs font-semibold px-2.5 py-0.5 rounded-full bg-white/[0.06] text-slate-300 border border-white/[0.08]">
            {repos.length} Guides
          </span>
        </div>
        <p class="text-sm text-slate-400 mt-1 max-w-2xl">
          {category.description}
        </p>
      </div>
    </div>

    <!-- Category Jump Link -->
    <a
      href={`#cat-${category.id}`}
      class="text-xs text-slate-400 hover:text-cyan-400 font-medium inline-flex items-center gap-1 transition-colors self-start sm:self-auto"
    >
      <span>Direct link</span>
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
      </svg>
    </a>
  </div>

  <!-- Cards Grid -->
  <div class="cards-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
    {repos.map(repo => (
      <RepoCard repo={repo} />
    ))}
  </div>
</section>
