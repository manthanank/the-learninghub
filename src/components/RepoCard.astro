---
import type { LearningRepo } from '../types/repo';

interface Props {
  repo: LearningRepo;
}

const { repo } = Astro.props;

const levelColors = {
  Beginner: 'text-emerald-400 bg-emerald-950/40 border-emerald-500/20',
  Intermediate: 'text-sky-400 bg-sky-950/40 border-sky-500/20',
  Advanced: 'text-purple-400 bg-purple-950/40 border-purple-500/20'
};

const categoryLabels: Record<string, string> = {
  frontend: 'Frontend',
  backend: 'Backend',
  devops: 'DevOps',
  databases: 'Databases',
  languages: 'Languages',
  'system-design': 'System Design'
};

const levelBadge = repo.level ? levelColors[repo.level] : levelColors.Intermediate;
---

<div
  class="repo-card group relative flex flex-col justify-between rounded-2xl bg-[#0d121f]/90 border border-white/[0.07] hover:border-cyan-500/30 p-5 sm:p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-cyan-950/30 overflow-hidden"
  data-name={repo.name}
  data-title={repo.title.toLowerCase()}
  data-desc={repo.description.toLowerCase()}
  data-category={repo.category}
  data-level={repo.level || 'Intermediate'}
  data-tags={repo.tags.join(',').toLowerCase()}
>
  <!-- Card Header Background Gradient Flare -->
  <div class="absolute -top-12 -right-12 w-32 h-32 bg-cyan-500/5 rounded-full blur-2xl group-hover:bg-cyan-500/10 transition-colors duration-500 pointer-events-none"></div>

  <!-- Top Metadata Row -->
  <div class="relative z-10">
    <div class="flex items-center justify-between gap-2 mb-3.5">
      <!-- Category Badge -->
      <span class="text-[11px] font-semibold tracking-wide uppercase px-2.5 py-0.5 rounded-md bg-white/[0.04] text-slate-300 border border-white/[0.08]">
        {categoryLabels[repo.category] || repo.category}
      </span>

      <!-- Difficulty Level & Featured Star -->
      <div class="flex items-center gap-1.5">
        {repo.isFeatured && (
          <span class="flex items-center gap-1 text-[10px] font-semibold px-2 py-0.5 rounded-md bg-amber-500/10 text-amber-300 border border-amber-500/20" title="Featured Guide">
            <svg class="w-3 h-3 fill-amber-400 text-amber-400" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
            Featured
          </span>
        )}
        {repo.level && (
          <span class={`text-[11px] font-medium px-2 py-0.5 rounded-md border ${levelBadge}`}>
            {repo.level}
          </span>
        )}
      </div>
    </div>

    <!-- Title & Repo Name -->
    <h3 class="text-lg font-bold text-white group-hover:text-cyan-300 transition-colors duration-200 line-clamp-1">
      <a href={repo.githubUrl} target="_blank" rel="noopener noreferrer" class="hover:underline flex items-center justify-between gap-2">
        <span>{repo.title}</span>
        <svg class="w-4 h-4 opacity-0 group-hover:opacity-100 transition-opacity text-cyan-400 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          <polyline points="15 3 21 3 21 9"></polyline>
          <line x1="10" y1="14" x2="21" y2="3"></line>
        </svg>
      </a>
    </h3>

    <div class="flex items-center gap-1.5 text-xs text-slate-400 font-mono mt-0.5 mb-2.5">
      <svg class="w-3.5 h-3.5 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-0-5H20"/>
      </svg>
      <span>{repo.name}</span>
    </div>

    <!-- Description -->
    <p class="text-sm text-slate-300/85 leading-relaxed line-clamp-2 min-h-[40px]">
      {repo.description}
    </p>

    <!-- Tag Chips -->
    <div class="flex flex-wrap gap-1.5 mt-4 pt-3 border-t border-white/[0.05]">
      {repo.tags.slice(0, 4).map(tag => (
        <span class="text-[11px] font-medium px-2 py-0.5 rounded bg-slate-800/80 text-slate-300 hover:text-cyan-300 hover:bg-slate-700/80 transition-colors">
          #{tag}
        </span>
      ))}
      {repo.tags.length > 4 && (
        <span class="text-[10px] text-slate-400 px-1 py-0.5">
          +{repo.tags.length - 4}
        </span>
      )}
    </div>
  </div>

  <!-- Card Footer -->
  <div class="mt-4 pt-3 border-t border-white/[0.06] flex items-center justify-between text-xs text-slate-400 relative z-10">
    <div class="flex items-center gap-3">
      {repo.stars !== undefined && repo.stars > 0 && (
        <span class="flex items-center gap-1 text-slate-300 font-mono">
          <svg class="w-3.5 h-3.5 text-amber-400 fill-amber-400" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
          {repo.stars}
        </span>
      )}
      {repo.forks !== undefined && repo.forks > 0 && (
        <span class="flex items-center gap-1 font-mono">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="6" y1="3" x2="6" y2="15"></line>
            <circle cx="18" cy="6" r="3"></circle>
            <circle cx="6" cy="18" r="3"></circle>
            <path d="M18 9a9 9 0 0 1-9 9"></path>
          </svg>
          {repo.forks}
        </span>
      )}
    </div>

    <a
      href={repo.githubUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1 text-xs font-semibold text-cyan-400 hover:text-cyan-300 group-hover:translate-x-0.5 transition-all duration-200"
    >
      <span>Explore Guide</span>
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
  </div>
</div>
