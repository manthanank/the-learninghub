---
import type { LearningRepo } from '../types/repo';

interface Props {
  repo: LearningRepo;
}

const { repo } = Astro.props;

const levelColors = {
  Beginner: 'text-emerald-400 bg-emerald-950/40 border-emerald-500/20',
  Intermediate: 'text-sky-400 bg-sky-950/40 border-sky-500/20',
  Advanced: 'text-purple-400 bg-purple-950/40 border-purple-500/20'
};

const statusColors = {
  Completed: 'text-emerald-300 bg-emerald-950/60 border-emerald-500/30',
  'In Progress': 'text-amber-300 bg-amber-950/60 border-amber-500/30',
  Roadmap: 'text-slate-400 bg-slate-900/60 border-slate-700/40'
};

const categoryLabels: Record<string, string> = {
  frontend: 'Frontend',
  backend: 'Backend',
  ai: 'AI & Agents',
  devops: 'DevOps & Cloud',
  databases: 'Databases',
  'testing-security': 'Testing & Security',
  languages: 'Languages',
  'system-design': 'System Design'
};

const levelBadge = repo.level ? levelColors[repo.level] : levelColors.Intermediate;
const statusBadge = repo.status ? statusColors[repo.status] : statusColors.Completed;
---

<div
  class="repo-card group relative flex flex-col justify-between rounded-2xl bg-[#0d121f]/90 border border-white/[0.07] hover:border-cyan-500/30 p-5 sm:p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-cyan-950/30 overflow-hidden"
  data-name={repo.name}
  data-title={repo.title.toLowerCase()}
  data-desc={repo.description.toLowerCase()}
  data-category={repo.category}
  data-level={repo.level || 'Intermediate'}
  data-status={repo.status || 'Completed'}
  data-tags={repo.tags.join(',').toLowerCase()}
>
  <!-- Card Header Background Gradient Flare -->
  <div class="absolute -top-12 -right-12 w-32 h-32 bg-cyan-500/5 rounded-full blur-2xl group-hover:bg-cyan-500/10 transition-colors duration-500 pointer-events-none"></div>

  <!-- Top Metadata Row -->
  <div class="relative z-10">
    <div class="flex items-center justify-between gap-2 mb-3.5">
      <!-- Category Badge -->
      <span class="text-[11px] font-semibold tracking-wide uppercase px-2.5 py-0.5 rounded-md bg-white/[0.04] text-slate-300 border border-white/[0.08]">
        {categoryLabels[repo.category] || repo.category}
      </span>

      <!-- Status & Difficulty Badge -->
      <div class="flex items-center gap-1.5 flex-wrap justify-end">
        {repo.status && (
          <span class={`flex items-center gap-1 text-[10px] font-semibold px-2 py-0.5 rounded-md border ${statusBadge}`}>
            {repo.status === 'Completed' && (
              <svg class="w-2.5 h-2.5 text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            )}
            {repo.status === 'In Progress' && (
              <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
            )}
            {repo.status}
          </span>
        )}

        {repo.level && (
          <span class={`text-[10px] font-medium px-2 py-0.5 rounded-md border ${levelBadge}`}>
            {repo.level}
          </span>
        )}
      </div>
    </div>

    <!-- Title & Repo Name -->
    <h3 class="text-lg font-bold text-white group-hover:text-cyan-300 transition-colors duration-200 line-clamp-1">
      <a href={repo.githubUrl} target="_blank" rel="noopener noreferrer" class="hover:underline flex items-center justify-between gap-2">
        <span>{repo.title}</span>
        <svg class="w-4 h-4 opacity-0 group-hover:opacity-100 transition-opacity text-cyan-400 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          <polyline points="15 3 21 3 21 9"></polyline>
          <line x1="10" y1="14" x2="21" y2="3"></line>
        </svg>
      </a>
    </h3>

    <div class="flex items-center gap-1.5 text-xs text-slate-400 font-mono mt-0.5 mb-2.5">
      <svg class="w-3.5 h-3.5 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-0-5H20"/>
      </svg>
      <span>{repo.name}</span>
      {repo.guideLines && (
        <span class="text-slate-500 text-[11px]">• {repo.guideLines.toLocaleString()} lines</span>
      )}
    </div>

    <!-- Description -->
    <p class="text-sm text-slate-300/85 leading-relaxed line-clamp-2 min-h-[40px]">
      {repo.description}
    </p>

    <!-- Tag Chips -->
    <div class="flex flex-wrap gap-1.5 mt-4 pt-3 border-t border-white/[0.05]">
      {repo.tags.slice(0, 4).map(tag => (
        <span class="text-[11px] font-medium px-2 py-0.5 rounded bg-slate-800/80 text-slate-300 hover:text-cyan-300 hover:bg-slate-700/80 transition-colors">
          #{tag}
        </span>
      ))}
      {repo.tags.length > 4 && (
        <span class="text-[10px] text-slate-400 px-1 py-0.5">
          +{repo.tags.length - 4}
        </span>
      )}
    </div>
  </div>

  <!-- Bottom Interactive CTA Bar -->
  <div class="mt-4 pt-3 border-t border-white/[0.06] flex items-center justify-between text-xs text-slate-400 relative z-10">
    <div class="flex items-center gap-3">
      {repo.stars !== undefined && repo.stars > 0 && (
        <span class="flex items-center gap-1 hover:text-amber-400 transition-colors" title="GitHub Stars">
          <svg class="w-3.5 h-3.5 fill-amber-400 text-amber-400" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
          {repo.stars}
        </span>
      )}
      {repo.language && (
        <span class="flex items-center gap-1">
          <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
          {repo.language}
        </span>
      )}
    </div>

    <a
      href={repo.githubUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1 text-cyan-400 hover:text-cyan-300 font-semibold transition-colors"
    >
      <span>Open Guide</span>
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </a>
  </div>
</div>
