---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="404: Page Not Found | The LearningHub">
  <Navbar totalGuides={42} />

  <main class="flex-1 flex items-center justify-center px-4 py-24 sm:py-32">
    <div class="text-center max-w-lg mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/10 border border-red-500/20 text-xs font-semibold text-red-400 mb-6">
        <span>Error 404</span>
      </div>

      <h1 class="text-5xl sm:text-7xl font-extrabold text-white tracking-tight font-mono">
        404
      </h1>

      <h2 class="text-2xl font-bold text-slate-200 mt-4">
        Learning Guide Not Found
      </h2>

      <p class="text-sm text-slate-400 mt-3 leading-relaxed">
        The guide or roadmap you are looking for might have been moved, renamed, or is currently being drafted.
      </p>

      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href="/"
          class="w-full sm:w-auto px-5 py-2.5 rounded-xl bg-cyan-500 text-[#07090e] font-semibold text-sm hover:bg-cyan-400 transition-colors shadow-lg shadow-cyan-500/20"
        >
          Back to Directory
        </a>
        <a
          href="https://github.com/manthanank"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto px-5 py-2.5 rounded-xl bg-white/[0.05] hover:bg-white/[0.1] border border-white/[0.1] text-white font-medium text-sm transition-colors"
        >
          View GitHub Profile
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
