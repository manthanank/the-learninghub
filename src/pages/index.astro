---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import StatsBanner from '../components/StatsBanner.astro';
import SearchFilter from '../components/SearchFilter.astro';
import CategorySection from '../components/CategorySection.astro';
import Footer from '../components/Footer.astro';
import { categories } from '../data/categories';
import { fetchRepos, getStats } from '../utils/fetchRepos';

const repos = await fetchRepos();
const stats = getStats(repos);
---

<Layout
  title="The LearningHub | 40+ Developer Guides & Tech Stacks"
  description="Explore 40+ curated developer repositories, guides, and roadmaps covering Frontend, Backend, DevOps, Databases, Languages, and System Design."
>
  <Navbar totalGuides={stats.totalGuides} />

  <main class="flex-1">
    <!-- Hero Section -->
    <section class="relative pt-16 pb-8 sm:pt-20 sm:pb-12 text-center overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <!-- Floating Announcement Pill -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-xs font-semibold text-cyan-400 mb-6 shadow-sm">
          <span class="flex h-2 w-2 rounded-full bg-cyan-400"></span>
          <span>Open Source Developer Ecosystem</span>
          <span class="text-slate-500">•</span>
          <span class="text-slate-300">{stats.totalGuides} Repositories</span>
        </div>

        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white">
          The <span class="bg-gradient-to-r from-cyan-400 via-sky-400 to-indigo-400 bg-clip-text text-transparent">LearningHub</span>
        </h1>

        <p class="mt-4 sm:mt-6 text-base sm:text-xl text-slate-300/90 max-w-2xl mx-auto leading-relaxed">
          A centralized directory of curated developer guides, code patterns, and practical roadmaps—from frontend frameworks to distributed system architectures.
        </p>

        <!-- Quick Technology Tags Bar -->
        <div class="mt-6 flex flex-wrap justify-center items-center gap-2 text-xs text-slate-400">
          <span class="text-slate-500">Includes:</span>
          {['React', 'Angular', 'Next.js', 'TypeScript', 'Node.js', 'Docker', 'Postgres', 'Python', 'Go', 'System Design'].map(tech => (
            <span class="px-2 py-0.5 rounded-md bg-white/[0.04] border border-white/[0.06] text-slate-300 font-mono text-[11px]">
              {tech}
            </span>
          ))}
        </div>
      </div>
    </section>

    <!-- Stats Banner -->
    <StatsBanner
      totalGuides={stats.totalGuides}
      totalCategories={stats.categoriesCount}
      totalTechnologies={stats.technologiesCount}
    />

    <!-- Interactive Real-Time Search & Filter -->
    <SearchFilter categories={categories} totalRepos={stats.totalGuides} />

    <!-- Categories & Cards Directory -->
    <div id="categories" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      {categories.map(cat => {
        const catRepos = repos.filter(r => r.category === cat.id);
        return <CategorySection category={cat} repos={catRepos} />;
      })}

      <!-- No Search Results Found State -->
      <div
        id="no-results-state"
        class="hidden py-20 text-center rounded-3xl bg-[#0e1424]/60 border border-white/[0.06] my-8 p-8"
      >
        <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-white/[0.04] border border-white/[0.08] flex items-center justify-center text-slate-400">
          <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            <line x1="8" y1="8" x2="14" y2="14"></line>
            <line x1="14" y1="8" x2="8" y2="14"></line>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-white mb-2">No matching learning guides found</h3>
        <p class="text-sm text-slate-400 max-w-md mx-auto mb-6">
          Try adjusting your search query, selecting "All Domains", or switching difficulty level filters.
        </p>
        <button
          type="button"
          onclick="document.getElementById('search-input').value = ''; document.getElementById('search-input').dispatchEvent(new Event('input'));"
          class="px-4 py-2 rounded-xl bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 hover:bg-cyan-500/30 text-xs font-semibold transition-all"
        >
          Reset Search Filters
        </button>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
